{
  "name": "labelguestxtc",
  "version": "4.5.5",
  "description": "LabelGuestXTC - modern label designer with variable data, barcode tools and native TSPL printing (MIT).",
  "homepage": "https://gitee.com/GuestXTC/LabelGuestXTC",
  "main": "main.js",
  "author": {
    "name": "LabelGuestXTC contributors",
    "email": "labelguestxtc@users.noreply.gitee.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:all": "electron-builder --win --mac --linux --x64"
  },
  "build": {
    "appId": "com.labelguestxtc.designer",
    "productName": "LabelGuestXTC",
    "copyright": "Copyright © LabelGuestXTC contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "LabelGuestXTC-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "LabelGuestXTC-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "LabelGuestXTC-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "xtc",
        "name": "LabelGuestXTC File",
        "description": "LabelGuestXTC 标签文件"
      },
      {
        "ext": "ddl",
        "name": "Label File (.ddl)",
        "description": ".ddl 标签文件"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "jsbarcode": "^3.11.6",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "jspdf": "^2.5.2"
  }
}
